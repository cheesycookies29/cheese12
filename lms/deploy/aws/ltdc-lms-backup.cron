# Nightly copy of the LMS data at 2:15 AM Philippine time; uploaded files mirrored at 2:20 AM, ATLAS Documents'
# (encrypted) files at 2:25 AM.
# Copies older than 30 days are deleted. Daily disk snapshots (7 kept) are taken by AWS as well.
15 2 * * * ltdc-lms cp /opt/ltdc-lms/data/db.json /opt/ltdc-lms/data/backups/db-$(date +\%F).json && find /opt/ltdc-lms/data/backups -name 'db-*.json' -mtime +30 -delete
# The audit log (its own file, kept apart from the data like CORE's) is copied too.
25 2 * * * ltdc-lms [ -f /opt/ltdc-lms/data/audit-log.jsonl ] && cp /opt/ltdc-lms/data/audit-log.jsonl /opt/ltdc-lms/data/backups/audit-log-$(date +\%F).jsonl && find /opt/ltdc-lms/data/backups -name 'audit-log-*.jsonl' -mtime +30 -delete
20 2 * * * ltdc-lms mkdir -p /opt/ltdc-lms/data/files /opt/ltdc-lms/data/backups/files && rsync -a /opt/ltdc-lms/data/files/ /opt/ltdc-lms/data/backups/files/
25 2 * * * ltdc-lms mkdir -p /opt/ltdc-lms/data/documents /opt/ltdc-lms/data/backups/documents && rsync -a --exclude uploads /opt/ltdc-lms/data/documents/ /opt/ltdc-lms/data/backups/documents/
# Job applicants' documents (encrypted under a key derived from the server key) at 2:30 AM.
30 2 * * * ltdc-lms [ -d /opt/ltdc-lms/data/applicant-files ] && mkdir -p /opt/ltdc-lms/data/backups/applicant-files && rsync -a /opt/ltdc-lms/data/applicant-files/ /opt/ltdc-lms/data/backups/applicant-files/
# Document circulation's forms (encrypted under a key derived from the server key) at 2:35 AM.
35 2 * * * ltdc-lms [ -d /opt/ltdc-lms/data/forms ] && mkdir -p /opt/ltdc-lms/data/backups/forms && rsync -a /opt/ltdc-lms/data/forms/ /opt/ltdc-lms/data/backups/forms/
